{
  "env": {
    "MCP_TIMEOUT": "120000"
  },
  "enabledMcpjsonServers": ["angular-cli"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
