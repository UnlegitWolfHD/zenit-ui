{
  "name": "zenit-ui-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:lib": "ng build zenit-ui && node tools/build-schematics.mjs",
    "build": "npm run build:lib && ng build ui-demo",
    "build:beispiel": "npm run build:lib && npm run snippets && ng build beispiel-app",
    "start:beispiel": "npm run build:lib && npm run snippets && ng serve beispiel-app",
    "snippets": "node tools/generate-example-snippets.mjs",
    "check:snippets": "node tools/generate-example-snippets.mjs --check",
    "check:themes": "node tools/check-theme-contrast.mjs",
    "test:schematics": "node tools/test-schematics.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:css": "stylelint \"projects/**/*.css\"",
    "format": "prettier --write \"projects/**/*.{ts,css,html}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,css,html}\"",
    "e2e": "playwright test",
    "e2e:beispiel": "playwright test -c playwright.beispiel.config.ts",
    "e2e:update": "playwright test --update-snapshots",
    "docs:api": "typedoc",
    "check": "npm run lint && npm run lint:css && npm run check:themes && npm run check:snippets && npm run build:lib && ng build ui-demo && ng build beispiel-app && ng test zenit-ui --watch=false && ng test beispiel-app --watch=false && npm run test:schematics && npm run format:check"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "material-icons": "^1.13.14",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.15.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  }
}
