projects/zenit-ui/src/styles/tokens.css

# The value of a metric and its unit must not be separated by a text node: the
# template glues "{{ value() }}" to the @if block so the only gap is the
# non-breaking space inside the <small>. Prettier breaks that line and Angular
# then collapses the indentation into a real space ("3,2  GB").
